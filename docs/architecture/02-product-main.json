      "tag": "完成后冻结候选",
      "width": 132
    },
    {
      "id": "independent-review",
      "lane": "delivery-main",
      "col": 4,
      "type": "security",
      "label": "独立验收",
      "sublabel": "红蓝 / 视觉 / 体验",
      "tag": "Terra · 独立任务",
      "width": 132
    },
    {
      "id": "purple-delivery",
      "lane": "delivery-main",
