      "label": "指定作者实现",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "accept",
      "label": "独立验收与交付",
      "fromCol": 4,
      "toCol": 5,
      "variant": "security"
    }
  ],
  "mainPath": [
    "sol-plan",
    "purple-plan",
    "foundation",
    "implementation",
    "independent-review",
    "purple-delivery",
    "sol-accept"
  ],
  "nodes": [
    {
      "id": "sol-plan",
      "lane": "delivery-main",
      "col": 0,
      "type": "backend",
      "label": "Sol 制定计划",
      "sublabel": "需求 / 选型 / 任务契约",
      "width": 132
    },
    {
      "id": "purple-plan",
      "lane": "delivery-main",
      "col": 1,
      "type": "security",
      "label": "Purple PLAN",
      "sublabel": "GLM 独立检查语义计划",
      "width": 132
    },
    {
      "id": "foundation",
      "lane": "delivery-main",
      "col": 2,
      "type": "backend",
      "label": "建立共享基础",
      "sublabel": "作者验证骨架与接口",
      "width": 132
    },
    {
      "id": "implementation",
      "lane": "delivery-main",
      "col": 3,
      "type": "backend",
      "label": "实现与集成",
